# Copy this file to backend\.env on the school server, then replace SERVER-IP.
APP_NAME="OFPPT Smart Attendance"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://SERVER-IP
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Free, local database. Use the exact folder where the project is installed.
DB_CONNECTION=sqlite
DB_DATABASE=C:/OFPPT-Attendance/backend/database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Keep email local unless the school configures an approved mail provider later.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="attendance@school.local"
MAIL_FROM_NAME="OFPPT Smart Attendance"
